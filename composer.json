{
  "name": "toastnz/theme-fonts",
  "description": "Silverstripe theme fonts module",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe",
    "theme fonts",
    "modular"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Emmanuel Davies",
      "homepage": "http://toast.co.nz/",
      "role": "Developer"
    },
    {
      "name": "Priscilla Yap",
      "homepage": "http://toast.co.nz/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "silverstripe/framework": "^6",
    "silverstripe/cms": "^6",
    "silverstripe/siteconfig": "^6",
    "silverstripe/asset-admin": "^3",
    "symbiote/silverstripe-gridfieldextensions": "^5",
    "composer/installers": "*"
  },
  "autoload": {
    "psr-4": {
      "Toast\\ThemeFonts\\": "src/"
    }
  },
  "extra": {
    "resources-dir": "_resources"
  },
  "suggest": {
    "silverstripe/subsites": "Each subsite gets its own fonts and generated files"
  }
}
